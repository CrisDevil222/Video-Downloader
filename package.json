{
  "name": "vidsaver",
  "version": "1.1.0",
  "description": "Download videos from YouTube, TikTok, Facebook, Instagram, Twitter/X",
  "main": "out/main/index.js",
  "author": {
    "name": "VidSaver Team"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "preview": "electron-vite preview",
    "download-bins": "node scripts/download-binaries.js",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.8.9",
    "p-limit": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "zustand": "^4.5.0"
  },
  "allowScripts": {
    "electron@36.9.5": true,
    "esbuild@0.21.5": true
  }
